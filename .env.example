# ULTRON AIR - backend environment
# Copy to `.env` (cp .env.example .env) and fill in what you need.
#
# NOTHING here is mandatory to BOOT. The server always starts and /health reports which
# integrations are live. Each variable below says what breaks when it is missing.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. Binds 0.0.0.0 so a phone on the same Wi-Fi can reach it. (default 4000)
PORT=4000

# development | production - production quiets dev-only logging. (default: development)
NODE_ENV=development

# silent | error | warn | info | debug - request/error log verbosity. Bodies are NEVER logged at any level. (default: info)
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Gemini - the language brain (intent, planning, replies, text translation)
# REQUIRED for: /api/assistant/turn understanding, /api/chat, /api/translate.
# Missing key => the server still answers, with canned fallback replies + degraded:"gemini".
# ---------------------------------------------------------------------------

# API key from https://aistudio.google.com/apikey - REQUIRED for real AI replies.
GEMINI_API_KEY=

# Model id used for every Gemini call. (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-3.6-flash

# Per-request timeout in ms for Gemini calls, incl. retries' individual attempts. (default: 15000)
GEMINI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Sarvam AI - Indian-language speech (TTS + STT)
# REQUIRED for: /api/speech/tts, /api/speech/stt, and the `audio` field anywhere.
# Missing key => every response returns audio: null and text only; STT returns 503.
# ---------------------------------------------------------------------------

# API key from https://dashboard.sarvam.ai - REQUIRED for any voice in or out.
SARVAM_API_KEY=

# Per-request timeout in ms for Sarvam TTS/STT calls. STT on long clips needs headroom. (default: 20000)
SARVAM_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# MongoDB - durable memory, preferences, safety profile, conversation history
# OPTIONAL. The server runs WITHOUT MongoDB: store.js transparently falls back to an
# in-process Map so every route still works for a demo. The only loss is persistence -
# memories, device prefs and safety contacts vanish on restart. /health reports db:false.
# ---------------------------------------------------------------------------

# Connection string. Leave blank to run purely in-memory (demo mode).
MONGODB_URI=mongodb://localhost:27017/ultron_air

# ---------------------------------------------------------------------------
# Safety layer
# ---------------------------------------------------------------------------

# Minimum gap in ms between two safety events of the same kind for one user, so a repeated
# trigger cannot spam emergency contacts. (default: 30000)
SAFETY_EVENT_COOLDOWN_MS=30000

# REQUIRED BEFORE HOSTING. Without it the server refuses to start when
# NODE_ENV=production, and runs open (with a loud warning) in development.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_TOKEN=

# Comma-separated browser origins allowed via CORS. Leave empty for a
# mobile-only backend.
CORS_ORIGINS=
